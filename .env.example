# AI Options Trading System Environment Variables
# Copy this file to .env and fill in your actual API keys

# Polygon.io API Key (required)
# Get your free API key from https://polygon.io/
POLYGON_API_KEY=your_polygon_api_key_here

# LLM API Keys (at least one required)
# OpenAI API Key for ChatGPT/GPT-4
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key for Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Logging Level (optional)
LOG_LEVEL=INFO

# Optional Configuration
ENVIRONMENT=development

# Database Configuration (if using external database)
# DATABASE_URL=sqlite:///data/trading_system.db

# Trading Configuration Overrides
# MAX_POSITION_SIZE=0.10
# MAX_DAILY_TRADES=5

# Backtesting Configuration
# BACKTEST_START_DATE=2023-01-01
# BACKTEST_END_DATE=2024-12-31
# INITIAL_CAPITAL=100000